---
// "Join the Circle" pop-up: the 10% welcome offer, styled to match the site.
// Sign-ups go straight to the MailerLite form (double opt-in), so no MailerLite
// script or cookie is ever loaded on the site.
// Opens on its own once per visit until someone joins (after 12 seconds or half a page
// of scrolling, and only after the cookie choice), or right away from any "Claim 10% Off" button.
import { newsletter } from '../data/site';
---
<dialog class="circle-pop" id="circle-pop" aria-labelledby="circle-title" data-subscribe={newsletter.subscribeUrl}>
  <div class="circle-card">
    <button type="button" class="circle-close" data-close aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    <div class="circle-body" data-step="form">
      <p class="eyebrow">Welcome gift</p>
      <h2 id="circle-title">Join the <em>Circle</em></h2>
      <p class="circle-offer"><strong>10% off</strong> your first course, consultation or masterclass.</p>
      <p class="soft">Plus monthly energy updates, early access to classes and new episodes in your inbox.</p>
      <form class="circle-form" novalidate>
        <div class="field"><label for="circle-name">First name</label><input id="circle-name" name="name" autocomplete="given-name"></div>
        <div class="field"><label for="circle-email">Email</label><input id="circle-email" name="email" type="email" autocomplete="email" required></div>
        <p class="circle-error" role="alert" hidden></p>
        <button class="btn btn-gold" type="submit">Send My 10%</button>
        <p class="mute circle-fine">Unsubscribe anytime. We never sell your data. <a href="/privacy">Privacy policy</a></p>
      </form>
    </div>

    <div class="circle-body" data-step="done" hidden tabindex="-1">
      <p class="eyebrow">Almost there</p>
      <h2>Check your <em>inbox</em></h2>
      <p class="soft">Tap the confirmation link we just sent. Your 10% code arrives in your welcome email right after.</p>
      <button type="button" class="btn btn-line" data-close>Back to the site</button>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('circle-pop') as HTMLDialogElement;
  const form = dlg.querySelector('form') as HTMLFormElement;
  const err = dlg.querySelector('.circle-error') as HTMLElement;
  const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
  const SEEN = 'hsaf-circle-seen', JOINED = 'hsaf-circle-joined';
  const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  // "Seen" lasts for this visit only (the browser tab session), so it returns on the next visit
  const seenThisVisit = () => { try { return sessionStorage.getItem(SEEN); } catch { return null; } };
  const markSeen = () => { try { sessionStorage.setItem(SEEN, '1'); } catch {} };
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

  const open = () => { if (!dlg.open) { dlg.showModal(); markSeen(); } };
  const close = () => dlg.close();

  // Any "Claim 10% Off" button opens it straight away
  document.querySelectorAll('[data-circle-open]').forEach((b) => b.addEventListener('click', open));
  dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); }); // click outside the card

  // Automatic opening: once per visit until they join, never on the thank-you page
  if (!get(JOINED) && !seenThisVisit() && !location.pathname.startsWith('/thanks')) {
    const arm = () => {
      let done = false;
      const fire = () => { if (done) return; done = true; window.removeEventListener('scroll', onScroll); open(); };
      const onScroll = () => { const h = document.documentElement; if (h.scrollTop > (h.scrollHeight - h.clientHeight) * 0.5) fire(); };
      setTimeout(fire, 12000);
      window.addEventListener('scroll', onScroll, { passive: true });
    };
    // Wait until the visitor has answered the cookie banner, so the two never stack
    if (get('hsaf-cookie-consent')) arm(); else document.addEventListener('hsaf:consent', arm, { once: true });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      err.textContent = 'Please enter a valid email address.';
      err.hidden = false;
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Sending…';
    try {
      const body = new URLSearchParams({ 'fields[email]': email, 'fields[name]': name, 'ml-submit': '1', anticsrf: 'true' });
      const res = await fetch(dlg.dataset.subscribe!, { method: 'POST', body });
      const data = await res.json();
      if (!data.success) throw new Error('rejected');
      set(JOINED, '1');
      dlg.querySelector<HTMLElement>('[data-step=form]')!.hidden = true;
      const done = dlg.querySelector<HTMLElement>('[data-step=done]')!;
      done.hidden = false;
      done.focus();
    } catch {
      err.innerHTML = 'Something went wrong. Please try again, or <a href="/contact?topic=newsletter">send us a message</a> and we’ll add you.';
      err.hidden = false;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send My 10%';
    }
  });
</script>
