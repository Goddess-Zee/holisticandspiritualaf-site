---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Your message was received." newsletter={false}>
  <section class="wrap" style="padding-top: 120px; padding-bottom: 140px; text-align: center;">
    <div class="stack" style="gap: 20px; align-items: center; max-width: 640px; margin: 0 auto;">
      <p class="eyebrow">Received with gratitude</p>
      <h1>Thank you, <em>luv</em></h1>
      <p class="lede" style="margin: 0 auto;">Your message is on its way to Goddess Zee. If it’s aligned, you’ll hear back by email soon.</p>
      <div class="btns" style="justify-content: center;"><a class="btn btn-gold" href="/podcast">Listen to the podcast</a><a class="btn btn-line" href="/">Back home</a></div>
    </div>
  </section>
</Base>
