---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page has moved or no longer exists." newsletter={false}>
  <section class="wrap" style="padding-top: 120px; padding-bottom: 140px; text-align: center;">
    <div class="stack" style="gap: 20px; align-items: center; max-width: 640px; margin: 0 auto;">
      <p class="eyebrow">404</p>
      <h1>This path has <em>shifted</em></h1>
      <p class="lede" style="margin: 0 auto;">The page you’re looking for has moved or no longer exists. Let’s get you back to center.</p>
      <div class="btns" style="justify-content: center;"><a class="btn btn-gold" href="/">Go home</a><a class="btn btn-line" href="/podcast">Listen to the podcast</a></div>
    </div>
  </section>
</Base>
