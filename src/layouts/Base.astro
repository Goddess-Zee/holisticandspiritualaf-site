---
import '../styles/global.css';
import { site, nav, navCta, social, newsletter as mailerlite } from '../data/site';
import Newsletter from '../components/Newsletter.astro';
import SocialIcons from '../components/SocialIcons.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>[];
  newsletter?: boolean;
}
const { title, description = site.description, image = site.ogImage, schema = [], newsletter = true } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const isHere = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#org`,
    name: site.name,
    url: site.url,
    logo: `${site.url}/favicon.png`,
    founder: { '@id': `${site.url}/#zee` },
    sameAs: social.map((s) => s.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/#zee`,
    name: site.founder,
    alternateName: site.founderAlias,
    jobTitle: 'Energy healer, author and podcast host',
    url: site.url,
    sameAs: social.map((s) => s.href),
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#120F0C">
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="sitemap" href="/sitemap-index.xml">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">

  <meta name="google-site-verification" content={site.verification.google}>
  <meta name="facebook-domain-verification" content={site.verification.facebook}>
  <meta name="p:domain_verify" content={site.verification.pinterest}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

  {[...baseSchema, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

  <!-- MailerLite: loads only after cookie consent, or when someone clicks a sign-up button -->
  <script is:inline set:html={`window.hsafLoadMailerLite=function(){if(window.hsafML)return;window.hsafML=1;(function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[]).push(arguments);},l=d.createElement(e),l.async=1,l.src=u,n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})(window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');ml('account', '${mailerlite.account}');};`} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="topbar">
    <div class="wrap">
      <a href="/podcast" class="topbar-msg">New podcast episodes every other Friday · Listen now</a>
      <SocialIcons size={18} />
    </div>
  </div>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">{site.shortName}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
      <nav id="main-nav" class="main-nav" aria-label="Main">
        <ul class="nav-top">
          {nav.map((n, i) => 'children' in n ? (
            <li class="has-sub">
              <button type="button" class="sub-toggle" aria-expanded="false" aria-controls={`sub-${i}`} data-current={n.children.some((c) => isHere(c.href)) ? '' : undefined}>
                {n.label}<svg class="caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <ul class="sub" id={`sub-${i}`}>
                {n.children.map((c) => (
                  <li><a href={c.href} aria-current={isHere(c.href) ? 'page' : undefined} {...(c.external ? { rel: 'noopener' } : {})}>
                    <span class="sub-label">{c.label}{c.external && <span aria-hidden="true"> ↗</span>}</span>
                    {c.note && <span class="sub-note">{c.note}</span>}
                  </a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={n.href} aria-current={isHere(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
          <li class="nav-cta-mobile"><a class="btn btn-gold" href={navCta.href}>{navCta.label}</a></li>
        </ul>
      </nav>
      <a class="btn btn-gold header-cta" href={navCta.href}>{navCta.label}</a>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  {newsletter && <Newsletter />}

  <footer class="site-footer">
    <div class="wrap">
      <div>© {new Date().getFullYear()} {site.name}™ · {site.founder}</div>
      <div class="footer-social"><span>Follow along</span><SocialIcons size={22} /></div>
      <nav aria-label="Legal" class="footer-legal"><a href="/about">About</a><a href="/be-a-guest">Be a Guest</a><a href="/contact">Contact</a><a href="/privacy">Privacy Policy</a><a href="/terms">Terms &amp; Conditions</a><a href="/cookies">Cookie Policy</a><a href="/accessibility">Accessibility</a><button type="button" data-cookie-settings>Cookie settings</button></nav>
    </div>
  </footer>
  <CookieBanner />

  <script>
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const menu = document.getElementById('main-nav');
    const toggles = [...document.querySelectorAll<HTMLButtonElement>('.sub-toggle')];
    const closeAll = (except?: HTMLButtonElement) => toggles.forEach((t) => { if (t !== except) t.setAttribute('aria-expanded', 'false'); });
    btn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('open') ?? false;
      btn.setAttribute('aria-expanded', String(open));
    });
    toggles.forEach((t) => {
      t.addEventListener('click', () => {
        const open = t.getAttribute('aria-expanded') !== 'true';
        closeAll(t);
        t.setAttribute('aria-expanded', String(open));
      });
    });
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.has-sub')) closeAll(); });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = toggles.find((t) => t.getAttribute('aria-expanded') === 'true');
      if (open) { closeAll(); open.focus(); }
    });
    // Close a dropdown once keyboard focus moves out of it
    document.querySelectorAll('.has-sub').forEach((li) => li.addEventListener('focusout', (e) => {
      if (!li.contains((e as FocusEvent).relatedTarget as Node)) li.querySelector('.sub-toggle')?.setAttribute('aria-expanded', 'false');
    }));
  </script>
</body>
</html>
